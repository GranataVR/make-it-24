              ".validate": "newData.val() === root.child('ww').child($code).child('deck').child($g).child(root.child('ww').child($code).child('seat').child($g).child($uid).val()).val()"
            }
          }
        },
        "over": {
          "$g": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists() && root.child('ww').child($code).child('game').child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['winner']) && (newData.child('winner').val() === 'w' || newData.child('winner').val() === 'v' || newData.child('winner').val() === 'j')",
            "winner": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "bi": {
      "$code": {
        "info": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && $code.matches(/^[a-z0-9]{4}$/)",
          ".validate": "newData.hasChildren(['by', 'createdAt']) && newData.child('by').val() === auth.uid",
          "by": {
            ".validate": "newData.isString()"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('bi').child($code).child('info').exists()",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "cfg": {
