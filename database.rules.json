          "host": {
            ".validate": "newData.isString()"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "card": {
            ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 1362"
          },
          "dealtAt": {
            ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === now)"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "len": {
            ".validate": "newData.val() === 10 || newData.val() === 15 || newData.val() === 20"
          },
          "base": {
