            ".validate": "newData.isBoolean()"
          },
          "white": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "game": {
          ".read": "auth != null",
          ".write": "auth != null && newData.exists() && root.child('bi').child($code).child('players').child(auth.uid).exists() && !data.parent().child('deck').child(newData.child('id').val()).exists() && newData.parent().child('deck').child(newData.child('id').val()).exists()",
          ".validate": "newData.hasChildren(['id', 'players', 'order', 'size', 'u', 'w', 'lang', 'adult', 'by', 'at']) && newData.child('by').val() === auth.uid",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^g[a-z0-9]{6,20}$/)"
          },
          "players": {
            "$uid": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            }
          },
          "order": {
            "$i": {
              ".validate": "newData.isString() && newData.parent().parent().child('players').child(newData.val()).exists()"
            }
          },
          "size": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 12"
          },
          "u": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
          },
          "w": {
            ".validate": "newData.val() === 0 || newData.val() === 1"
          },
          "lang": {
            ".validate": "newData.val() === 'id' || newData.val() === 'en'"
          },
          "adult": {
            ".validate": "newData.isBoolean()"
          },
          "by": {
            ".validate": "newData.isString()"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "deck": {
          "$g": {
            ".write": "auth != null && !data.exists() && newData.parent().parent().child('game').child('id').val() === $g && newData.parent().parent().child('game').child('by').val() === auth.uid",
            "$slot": {
              ".read": "auth != null && root.child('bi').child($code).child('claim').child($g).child($slot).val() === auth.uid",
              ".validate": "$slot.matches(/^s([0-9]|1[01])$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            }
          }
        },
        "deckr": {
          "$g": {
            ".write": "auth != null && !data.exists() && newData.parent().parent().child('game').child('id').val() === $g && newData.parent().parent().child('game').child('by').val() === auth.uid",
            "$slot": {
              ".validate": "$slot.matches(/^s([0-9]|1[01])$/) && (newData.val() === 'c' || newData.val() === 'u' || newData.val() === 'w')"
            }
          }
        },
        "word": {
          "$g": {
            ".write": "auth != null && !data.exists() && newData.parent().parent().child('game').child('id').val() === $g && newData.parent().parent().child('game').child('by').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,30}$/)"
          }
        },
        "claim": {
          "$g": {
            "$slot": {
              ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('bi').child($code).child('game').child('id').val() === $g && root.child('bi').child($code).child('game').child('players').child(auth.uid).exists() && root.child('bi').child($code).child('deckr').child($g).child($slot).exists() && !root.child('bi').child($code).child('seat').child($g).child(auth.uid).exists() && newData.parent().parent().parent().child('seat').child($g).child(auth.uid).val() === $slot"
            }
          }
        },
        "seat": {
          "$g": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.parent().parent().parent().child('claim').child($g).child(newData.val()).val() === auth.uid",
              ".validate": "newData.isString()"
            }
          }
        },
        "phase": {
          "$g": {
            ".read": "auth != null",
            ".write": "auth != null && newData.parent().parent().child('game').child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['n', 'stage', 'startedAt', 'endsAt'])",
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "stage": {
              ".validate": "newData.val() === 'deal' || newData.val() === 'talk' || newData.val() === 'vote' || newData.val() === 'white' || newData.val() === 'over'"
            },
            "startedAt": {
              ".validate": "newData.isNumber()"
            },
            "endsAt": {
              ".validate": "newData.isNumber()"
            },
            "turn": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
            },
            "speaker": {
              ".validate": "newData.isString()"
            },
            "white": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "done": {
          "$g": {
            ".read": "auth != null",
            "$n": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('bi').child($code).child('game').child('players').child(auth.uid).exists()",
                ".validate": "newData.val() === true"
              }
            }
          }
        },
        "chat": {
          ".read": "auth != null",
          "$m": {
            ".write": "auth != null && !data.exists() && root.child('bi').child($code).child('players').child(auth.uid).exists() && (!root.child('bi').child($code).child('game').exists() || root.child('bi').child($code).child('over').child(root.child('bi').child($code).child('game').child('id').val()).exists() || (root.child('bi').child($code).child('game').child('players').child(auth.uid).exists() && !root.child('bi').child($code).child('out').child(root.child('bi').child($code).child('game').child('id').val()).child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['by', 't', 'at']) && newData.child('by').val() === auth.uid",
            "by": {
              ".validate": "newData.isString()"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "clue": {
          "$g": {
            ".read": "auth != null",
            "$n": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('bi').child($code).child('phase').child($g).child('stage').val() === 'talk' && root.child('bi').child($code).child('phase').child($g).child('speaker').val() === auth.uid && !root.child('bi').child($code).child('out').child($g).child(auth.uid).exists()",
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && newData.val().length - newData.val().replace(' ', '').length <= 2"
              }
            }
          }
        },
        "vote": {
          "$g": {
            ".read": "auth != null",
            "$n": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('bi').child($code).child('game').child('players').child(auth.uid).exists() && !root.child('bi').child($code).child('out').child($g).child(auth.uid).exists() && root.child('bi').child($code).child('phase').child($g).child('stage').val() === 'vote' && !root.child('bi').child($code).child('res').child($g).child($n).exists()",
                ".validate": "newData.isString() && (newData.val() === 'skip' || (newData.val() !== auth.uid && root.child('bi').child($code).child('game').child('players').child(newData.val()).exists() && !root.child('bi').child($code).child('out').child($g).child(newData.val()).exists()))"
              }
            }
          }
        },
        "res": {
          "$g": {
            ".read": "auth != null",
            "$n": {
              ".write": "auth != null && !data.exists() && root.child('bi').child($code).child('game').child('players').child(auth.uid).exists()",
              ".validate": "newData.isString() && (newData.val() === 'none' || root.child('bi').child($code).child('game').child('players').child(newData.val()).exists())"
            }
          }
        },
        "out": {
          "$g": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && !data.exists() && root.child('bi').child($code).child('game').child('players').child(auth.uid).exists()",
              ".validate": "newData.isString() && (root.child('bi').child($code).child('res').child($g).child(newData.val()).val() === $uid || (newData.val().matches(/^i[0-9]{1,2}$/) && root.child('bi').child($code).child('game').child('players').child($uid).exists()))"
            }
          }
        },
        "role": {
          "$g": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && !data.exists() && root.child('bi').child($code).child('game').child('players').child(auth.uid).exists() && (root.child('bi').child($code).child('out').child($g).child($uid).exists() || root.child('bi').child($code).child('over').child($g).exists())",
              ".validate": "newData.val() === root.child('bi').child($code).child('deckr').child($g).child(root.child('bi').child($code).child('seat').child($g).child($uid).val()).val()"
            }
          }
        },
        "guess": {
          "$g": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists() && root.child('bi').child($code).child('deckr').child($g).child(root.child('bi').child($code).child('seat').child($g).child(auth.uid).val()).val() === 'w' && root.child('bi').child($code).child('out').child($g).child(auth.uid).exists() && root.child('bi').child($code).child('phase').child($g).child('stage').val() === 'white'",
            ".validate": "newData.hasChildren(['k', 't'])",
            "k": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,30}$/)"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "gres": {
          "$g": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists() && root.child('bi').child($code).child('game').child('players').child(auth.uid).exists() && root.child('bi').child($code).child('guess').child($g).exists()",
            ".validate": "(newData.val() === true && root.child('bi').child($code).child('guess').child($g).child('k').val() === root.child('bi').child($code).child('word').child($g).val()) || (newData.val() === false && root.child('bi').child($code).child('guess').child($g).child('k').val() !== root.child('bi').child($code).child('word').child($g).val())"
          }
        },
        "over": {
          "$g": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists() && root.child('bi').child($code).child('game').child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['winner']) && (newData.child('winner').val() === 'c' || newData.child('winner').val() === 'u' || newData.child('winner').val() === 'w')",
            "winner": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "show": {
          "$g": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('bi').child($code).child('over').child($g).exists()",
              ".validate": "newData.val() === root.child('bi').child($code).child('deck').child($g).child(root.child('bi').child($code).child('seat').child($g).child(auth.uid).val()).val()"
            }
          }
        }
      }
    }
  }
